@article{poulsenThalassiosiraPseudonanaCyclotella2023,
  title = {Thalassiosira Pseudonana ({{Cyclotella}} Nana) ({{Hustedt}}) {{Hasle}} et {{Heimdal}} ({{Bacillariophyceae}}): {{A}} Genetically Tractable Model Organism for Studying Diatom Biology, Including Biological Silica Formation},
