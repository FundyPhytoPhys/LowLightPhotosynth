@article{saneTransientExchangePhotosystem2002,
  title = {A {{Transient Exchange}} of the {{Photosystem II Reaction Center Protein D1}}:1 with {{D1}}:2 during {{Low Temperature Stress ofSynechococcus}} Sp. {{PCC}} 7942 in the {{Light Lowers}} the {{Redox Potential}} of {{QB}}*},
  shorttitle = {A {{Transient Exchange}} of the {{Photosystem II Reaction Center Protein D1}}},
  author = {Sane, P. V. and Ivanov, Alexander G. and Sveshnikov, Dmitry and Huner, Norman P. A. and O{\textasciidieresis}quist, Gunnar},
  year = 2002,
  month = sep,
  journal = {Journal of Biological Chemistry},
  volume = {277},
  number = {36},
  pages = {32739--32745},
  publisher = {Elsevier},
  issn = {0021-9258, 1083-351X},
  doi = {10.1074/jbc.M200444200},
  urldate = {2025-02-14},
  abstract = {{$<$}p{$>$}Upon exposure to low temperature under constant light conditions, the cyanobacterium \emph{Synechococcus} sp. PCC 7942 exchanges the photosystem II reaction center D1 protein form 1 (D1:1) with D1 protein form 2 (D1:2). This exchange is only transient, and after acclimation to low temperature the cells revert back to D1:1, which is the preferred form in acclimated cells (Campbell, D., Zhou, G., Gustafsson, P., O\textasciidieresis quist, G., and Clarke, A. K. (1995) \emph{EMBO J.} 14, 5457--5466). In the present work we use thermoluminescence to study charge recombination events between the acceptor and donor sides of photosystem II in relation to D1 replacement. The data indicate that in cold-stressed cells exhibiting D1:2, the redox potential of Q\textsubscript{B} becomes lower approaching that of Q\textsubscript{A}. This was confirmed by examining the\emph{Synechococcus} sp. PCC 7942 inactivation mutants R2S2C3 and R2K1, which possess only D1:1 or D1:2, respectively. In contrast, the recombination of \emph{Q} {$<$}mml:math{$><$}mml:mrow{$><$}/mml:mrow{$><$}mml:mrow{$>$}A{$<$}/mml:mrow{$><$}mml:mrow{$><$}mml:mo{$>-<$}/mml:mo{$><$}/mml:mrow{$><$}/mml:math{$>$} with the S\textsubscript{2} and S\textsubscript{3} states did not show any change in their redox characteristics upon the shift from D1:1 to D1:2. We suggest that the change in redox properties of Q\textsubscript{B} results in altered charge equilibrium in favor of Q\textsubscript{A}. This would significantly increase the probability of \emph{Q} {$<$}mml:math{$><$}mml:mrow{$><$}/mml:mrow{$><$}mml:mrow{$>$}A{$<$}/mml:mrow{$><$}mml:mrow{$><$}mml:mo{$>-<$}/mml:mo{$><$}/mml:mrow{$><$}/mml:math{$>$}and P680\textsuperscript{+} recombination. The resulting non-radiative energy dissipation within the reaction center of PSII may serve as a highly effective protective mechanism against photodamage upon excessive excitation. The proposed reaction center quenching is an important protective mechanism because antenna and zeaxanthin cycle-dependent quenching are not present in cyanobacteria. We suggest that lowering the redox potential of Q\textsubscript{B} by exchanging D1:1 for D1:2 imparts the increased resistance to high excitation pressure induced by exposure to either low temperature or high light.{$<$}/p{$>$}},
  langid = {english},
  pmid = {12105211},
  file = {/Users/dcampbel/Zotero/storage/L2GWCXDD/Sane et al. - 2002 - A Transient Exchange of the Photosystem II Reactio.pdf}
}

@article{sassoMolecularManipulationDomesticated2018,
  title = {From Molecular Manipulation of Domesticated {{Chlamydomonas}} Reinhardtii to Survival in Nature},
