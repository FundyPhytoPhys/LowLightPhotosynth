@article{wirtzNonuniformScalingPhytoplankton2011,
  title = {Non-Uniform Scaling in Phytoplankton Growth Rate Due to Intracellular Light and {{CO2}} Decline},
  author = {Wirtz, Kai W.},
  year = 2011,
  month = sep,
  journal = {Journal of Plankton Research},
  volume = {33},
  number = {9},
  pages = {1325--1341},
  issn = {0142-7873},
  doi = {10.1093/plankt/fbr021},
  urldate = {2023-06-16},
  abstract = {Scaling laws are central to relate ecological and physiological traits in unicellular autotrophs. Classical uniform scaling applied to phytoplankton maximum growth rate ({$\mu$}max), however, meets several theoretical and empirical limitations. As an alternative model, I propose a non-uniform size dependency of {$\mu$}max by considering how the geometry of unicells determines photosynthetic capacity. The model starts from physical laws of absorption and diffusion and uses known biochemical or biophysical coefficients. Calculated intracellular light and CO2 levels decline from the membrane to the cell centre, which may depress photosynthesis even under optimal growth conditions. Combination of the depletion model with a mechanistically motivated scaling rule for respiration generates a uni-modal size function for {$\mu$}max. The function greatly improves predictions of classical allometries, in particular, for small cells and across taxonomic groups. Uni-modality in {$\mu$}max has various implications for phytoplankton eco-physiology and morphology, correctly describing the absence of very small diatoms or giant green algae. For larger size classes, an increased benefit of non-spherical forms or of elevated pCO2 is calculated, whereas the advantage of carbon concentrating mechanisms turns out to be maximal for intermediate sizes. The model also points to a high degree of co-adaptation in different uptake systems.},
  file = {/Users/dcampbel/Zotero/storage/2LPD286V/1527153.html}
}

