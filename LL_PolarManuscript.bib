  pages = {1--44},
  publisher = {John Wiley \& Sons, Ltd},
  doi = {10.1002/9781119842156.ch1},
  urldate = {2026-01-08},
  abstract = {Diatoms are an important group of eukaryotic phytoplankton, responsible for about a quarter of CO 2 fixation on Earth. Oxygenic photosynthesis uses the same building blocks throughout the species diversity, with highly conserved photosynthetic complexes and Calvin-Benson-Bassham cycle enzymes. However, many differences are observed in the spatial organization of the photosynthetic apparatus and in the regulation of the photochemical and chemical phases of photosynthesis. Here, we describe the similarities and differences between diatom photosynthesis and that of the green lineage. We focus on the spatial organization of photosynthetic complexes, different routes of photosynthetic electron transfers, the regulation of CO 2 concentration and fixation, and the orchestration of the general response of photosynthesis to environmental changes.},
