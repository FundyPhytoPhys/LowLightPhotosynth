@article{otteDiatomFragilariopsisCylindrus2023,
  title = {The Diatom {{Fragilariopsis}} Cylindrus: {{A}} Model Alga to Understand Cold-Adapted Life},
  shorttitle = {The Diatom {{Fragilariopsis}} Cylindrus},
  author = {Otte, Antonia and Winder, Johanna C. and Deng, Longji and Schmutz, Jeremy and Jenkins, Jerry and Grigoriev, Igor V. and Hopes, Amanda and Mock, Thomas},
