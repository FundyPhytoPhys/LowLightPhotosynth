@article{saneChangesRedoxPotential2003,
  title = {Changes in the {{Redox Potential}} of {{Primary}} and {{Secondary Electron-Accepting Quinones}} in {{Photosystem II Confer Increased Resistance}} to {{Photoinhibition}} in {{Low-Temperature-Acclimated Arabidopsis}}},
  author = {Sane, Prafullachandra Vishnu and Ivanov, Alexander G. and Hurry, Vaughan and Huner, Norman P.A. and {\"O}quist, Gunnar},
  year = 2003,
  month = aug,
  journal = {Plant Physiology},
  volume = {132},
  number = {4},
  pages = {2144--2151},
  issn = {0032-0889},
  doi = {10.1104/pp.103.022939},
  urldate = {2025-02-14},
  abstract = {Exposure of control (non-hardened) Arabidopsis leaves for 2 h at high irradiance at 5{$^\circ$}C resulted in a 55\% decrease in photosystem II (PSII) photochemical efficiency as indicated by F ~v ~/F ~m. In contrast, cold-acclimated leaves exposed to the same conditions showed only a 22\% decrease in F ~v ~/F ~m. Thermoluminescence was used to assess the possible role(s) of PSII recombination events in this differential resistance to photoinhibition. Thermoluminescence measurements of PSII revealed that S2QA ~- recombination was shifted to higher temperatures, whereas the characteristic temperature of the S2QB ~- recombination was shifted to lower temperatures in cold-acclimated plants. These shifts in recombination temperatures indicate higher activation energy for the S2QA ~- redox pair and lower activation energy for the S2QB ~- redox pair. This results in an increase in the free-energy gap between P680+QA ~- and P680+Pheo- and a narrowing of the free energy gap between primary and secondary electron-accepting quinones in PSII electron acceptors. We propose that these effects result in an increased population of reduced primary electron-accepting quinone in PSII, facilitating non-radiative P680+QA ~- radical pair recombination. Enhanced reaction center quenching was confirmed using in vivo chlorophyll fluorescence-quenching analysis. The enhanced dissipation of excess light energy within the reaction center of PSII, in part, accounts for the observed increase in resistance to high-light stress in cold-acclimated Arabidopsis plants.},
  file = {/Users/dcampbel/Zotero/storage/2VE54ZXM/Sane et al. - 2003 - Changes in the Redox Potential of Primary and Seco.pdf}
}

@article{saneTransientExchangePhotosystem2002,
  title = {A {{Transient Exchange}} of the {{Photosystem II Reaction Center Protein D1}}:1 with {{D1}}:2 during {{Low Temperature Stress ofSynechococcus}} Sp. {{PCC}} 7942 in the {{Light Lowers}} the {{Redox Potential}} of {{QB}}*},
  shorttitle = {A {{Transient Exchange}} of the {{Photosystem II Reaction Center Protein D1}}},
  author = {Sane, P. V. and Ivanov, Alexander G. and Sveshnikov, Dmitry and Huner, Norman P. A. and O{\textasciidieresis}quist, Gunnar},
  year = 2002,
  month = sep,
